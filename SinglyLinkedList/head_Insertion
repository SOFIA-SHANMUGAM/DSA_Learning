import java.util.*;
class Node{
    Node next;
    int data;
    Node(int data){
        this.data = data;
        this.next = null;
    }
}
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int n = sc.nextInt();
	    Node head = null;
	    for(int i=0; i<n; i++){
	        int element = sc.nextInt();
	        Node newnode = new Node(element);
	        newnode.next = head;
	        head = newnode;
	    }
	    while(head != null){
	        System.out.print(head.data+" ");
	        head = head.next;
	    }
	}
}
