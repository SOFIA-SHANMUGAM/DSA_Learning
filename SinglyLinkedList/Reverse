import java.util.*;
class Node{
    Node next;
    int data;
    Node(int data){
        this.data = data;
        this.next = null;
    }
}
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		Node dummy = new Node(-1);
		Node tail = dummy;
		for(int i=0; i<n; i++){
		    int num = sc.nextInt();
		    Node newnode = new Node(num);
		    tail.next = newnode;
		    tail = tail.next;
		}
		Node current = dummy.next;
		Node previous = null;
		while(current != null){
		    Node next = current.next;
		    current.next = previous;
		    previous = current;
		    current = next;
		}
		Node head = previous;
		while(head != null){
		    System.out.print(head.data+" ");
		    head = head.next;
		}
	}
}
