import java.util.*;
class Node{
    Node next;
    int data;
    Node(int data){
        this.data = data;
        this.next = null;
    }
}
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		Node dummy = new Node(-1);
		Node tail = dummy;
		for(int i=0; i<n; i++){
		    int num = sc.nextInt();
		    Node newnode = new Node(num);
		    tail.next = newnode;
		    tail = tail.next;
		}
		Node slow = dummy.next;
		Node fast = dummy.next;
		while(fast.next != null && fast.next.next != null){
		    slow = slow.next;
		    fast = fast.next.next;
		}
		System.out.print(slow.data);
	}
}
